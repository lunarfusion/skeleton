.branding {
  position: relative;
  padding: 1rem 2rem;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  
  &__content {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
  
  &__logo {
    inline-size: 80px;
  }
  
  &__sitename {
    font-family: var(--skeleton-font-serif);
    color: var(--skeleton-color-fg-base);
    font-size: 48px;
    font-weight: 500;
    line-height: 1.1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    
    a,
    a:hover,
    a:focus,
    a:visited,
    a:active {
      font-size: inherit;
      color: var(--skeleton-color-fg-base);
      text-decoration: none;
    }
  }
  
  &__siteslogan {
    font-size: 18px;
    color: var(--skeleton-color-fg-base);
    font-weight: 500;
    font-family: var(--skeleton-font-primary);
  }
  
  @media (width <=776px) {
    padding: 1rem 0.75rem;
  }
  
  @media (width <=994px) {
    inline-size: 100%;
  }
}