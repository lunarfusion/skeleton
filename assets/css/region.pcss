.region {
  position: relative;
  
  &--header {
    --skeleton-space-x-inner-row: var(--skeleton-size-gap-x);
    position: relative;
    display: flex;
    flex-direction: row;
    inline-size: 100%;
    justify-content: space-between;
    align-items: center;
    
    @media (width <=994px) {
      flex-direction: column;
      /* realign flex for mobile nav to work */
      align-items: initial;
    }
  }
  
  &--sidebar-second,
  &--sidebar-first {
    padding-inline-start: calc(var(--skeleton-size-gap-x) * 2);
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-block-start: 6rem;
    
    .block__content {
      padding-inline-start: var(--skeleton-size-gap-x);
    }
    
    @media (width <=994px) {
      padding-inline-start: var(--skeleton-size-gap-x);
      margin-block-start: 1rem;
    }
  }
}