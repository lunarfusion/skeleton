{%
  set classes = [
    'title',
    variant and variant != 'default' ? 'title--' ~ variant,
    size ? 'title--size' ~ size,
  ]
%}


{# <{{ html_tag|default('h3') }}
 {{ attributes.addClass(classes) }}>
    {{ content }}
</{{ html_tag|default('h3') }}> #}


{% set heading_level = heading_level|default(3) %}
<h{{ heading_level }}{{ attributes.addClass(classes) }}>
  {{ content }}
</h{{ heading_level }}>
