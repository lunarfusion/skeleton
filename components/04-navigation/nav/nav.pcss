/*** Navigation Variables ***/
.nav {
  --skeleton-size-border-subnav-main: 3px;
  --skeleton-size-border-nav-list: 2px;
  --skeleton-size-nav-dropdown-icon: 1rem;
  
  --skeleton-size-border-navlink: 0px;
  --skeleton-size-radius-navlink: 4px;
  --skeleton-size-radius-subnav: var(--skeleton-size-radius-med);
  
  --skeleton-size-underline-navlink: 6px;
  
  --skeleton-size-text-nav-level-0: 0.85rem;
  --skeleton-size-text-nav-level-1: 0.75rem;
  --skeleton-size-text-nav-level-2: 0.65rem;
  
  --skeleton-size-space-y-nav-item: 0.65rem;
  --skeleton-size-space-x-nav-item: 0.55rem;
  
  --skeleton-transition-nav-icon: var(--skeleton-transition-basic);
  --skeleton-transition-nav-item: var(--skeleton-transition-basic);
  
  /*** Color Theme - Default Transparent ***/
  --skeleton-color-text-nav-item: var(--skeleton-color-fg-base);
  --skeleton-color-text-nav-item-hover: var(--skeleton-color-fg-base);
  --skeleton-color-text-nav-item-active-trail: var(--skeleton-color-fg-action-default);
  --skeleton-color-border-nav-item: var(--skeleton-color-border-neutral-subdued);
  --skeleton-color-border-nav-item-secondary: var(--skeleton-color-border-neutral-extra-subdued);
  --skeleton-color-action-nav-fg-icon: var(--skeleton-color-accent);
  
  --skeleton-color-bg-subnav: transparent;
  --skeleton-color-bg-nav-main: transparent;
  --skeleton-color-bg-subnav-main: var(--skeleton-color-bg-neutral-l2);
  --skeleton-color-bg-nav-item-hover: var(--skeleton-color-bg-neutral-l3);
  
  /* mobile */
  --skeleton-color-bg-nav-mobile: var(--skeleton-color-bg-base);
  --skeleton-color-border-nav-mobile: var(--skeleton-color-border-primary);
  
  --skeleton-color-border-subnav-main: var(--skeleton-color-bg-neutral-l3);
  --skeleton-color-border-bottom-subnav-main: var(--skeleton-color-bg-neutral-l2);
  --skeleton-color-accent-nav-item: var(--skeleton-color-border-primary);
}

/*** Navigation Styles ***/
.nav {
  inline-size: 100%;
  position: relative;
  display: flex;
  align-items: center;
  Justify-content: stretch;
  
  /*** UL element ***/
  &__list {
    position: relative;
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    margin: 0;
    padding: 0;
    background-color: var(--skeleton-color-bg-subnav);
    list-style-type: none;
    font-size: 0;
    
    .nav__list {
      background-color: transparent;
    }
  }
  
  /*** LI element ***/
  &__item {
    position: relative;
    margin: 0;
    padding: var(--skeleton-size-space-y-nav-item) var(--skeleton-size-space-x-nav-item);
    transition: var(--skeleton-transition-nav-item);
    
    /* foreground */
    color: var(--skeleton-color-text-nav-item);
    font-size: var(--skeleton-size-text-nav-level-0);
    line-height: 1.3;
    
    &:marker {
      display: none;
    }
    
    &--level-0 {
      font-size: var(--skeleton-size-text-nav-level-0);
      
      /* horizontal rule between items */
      &::before {
        position: absolute;
        display: block;
        content: "";
        width: 100%;
        height: 5px;
        top: 0;
        box-shadow: var(--skeleton-color-border-nav-item) 0px -0.5px 0px;
      }
    }
    
    &--level-1 {
      font-size: var(--skeleton-size-text-nav-level-1);
      padding-block: calc(var(--skeleton-size-space-y-nav-item) * 0.75);
    }
    
    &--level-2 {
      font-size: var(--skeleton-size-text-nav-level-2);
      padding-block: calc(var(--skeleton-size-space-y-nav-item) * 0.25);
    }
    
    &--active-trail {
      color: var(--skeleton-color-text-nav-item-active-trail);
    }
    
    &--active-trail > .nav__link {
      font-weight: 600;
      color: var(--skeleton-color-text-nav-item-active-trail);
    }
  }
  
  /*** Link and Subnav Toggle Element ***/
  &__link,
  &__subnav-toggle {
    position: relative;
    display: inline-block;
    padding: var(--skeleton-size-underline-navlink);
    border: 0;
    outline: none;
    background: transparent;
    transition: var(--skeleton-transition-nav-item);
    /* foreground */
    text-align: start;
    line-height: inherit;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-decoration: none;
    color: inherit;
    /* background */
    background: linear-gradient(var(--skeleton-color-border-secondary) 50%, transparent 51%);
    background-repeat: no-repeat;
    background-position: var(--skeleton-size-underline-navlink) 100%;
    background-size: 0% var(--skeleton-size-underline-navlink);
    
    /*** Focus Indicator ***/
    &::after {
      position: absolute;
      margin: auto;
      content: "";
      left: 0;
      top: 0;
      z-index: -1;
      inline-size: calc(100% + (var(--skeleton-size-gap-focus-indicator) * 2) + (var(--skeleton-size-border-navlink) * 2));
      block-size: calc(100% + (var(--skeleton-size-gap-focus-indicator) * 2) + (var(--skeleton-size-border-navlink) * 2));
      
      margin-block-start: calc((var(--skeleton-size-gap-focus-indicator) + var(--skeleton-size-focus-indicator) + var(--skeleton-size-border-navlink)) * -1);
      margin-inline-start: calc((var(--skeleton-size-gap-focus-indicator) + var(--skeleton-size-focus-indicator) + var(--skeleton-size-border-navlink)) * -1);
      border-width: var(--skeleton-size-focus-indicator);
      border-style: solid;
      border-color: var(--skeleton-color-focus-indicator);
      
      border-radius: calc(var(--skeleton-size-radius-navlink) + var(--skeleton-size-gap-focus-indicator) + var(--skeleton-size-border-navlink));
      opacity: 0;
    }
    
    /*** Link State - Hover ***/
    &:hover {
      color: var(--skeleton-color-text-nav-item-hover);
      /* background-color: var(--skeleton-color-bg-nav-item-hover); */
      background-size: calc(100% - (var(--skeleton-size-underline-navlink) * 2)) var(--skeleton-size-underline-navlink);
      
      &::after {
        opacity: 0;
      }
    }
    
    /*** State: Focus ***/
    /* use focus-visible so focus indicator does not fire on click */
    &:focus-visible {
      &::after {
        opacity: 1;
        z-index: 2;
      }
    }
    
    /*** prevent focus from firing on click ***/
    &:-webkit-focus-ring {
      border-color: transparent;
      outline: none;
      box-shadow: none;
    }
  }
  
  /*** Button ***/
  &__subnav-toggle {
    padding-inline-end: calc(var(--skeleton-size-nav-dropdown-icon) * 1.25);
    cursor: pointer;
    
    /*** dropdown indicator - points right when collapsed ***/
    &::before {
      position: absolute;
      right: calc(var(--skeleton-size-underline-navlink) * 0.5);
      display: inline-flex;
      justify-self: center;
      align-self: center;
      transition: var(--skeleton-transition-nav-icon);
      transform: rotate(-90deg);
      content: "\f107";
      /* fg styles */
      font-family: "FontAwesome";
      font-weight: 700;
      font-size: var(--skeleton-size-nav-dropdown-icon);
      color: var(--skeleton-color-action-nav-fg-icon);
    }
  }
  
  /************ VARIANTS ************/
  /*** Variant - Collapsible ***/
  &--collapsible {
    
    .nav__subnav-wrapper {
      inline-size: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      z-index: 9;
      
      > .nav__list {
        transform: translateY(-100%);
        opacity: 0;
      }
    }
    
    details {
      
      summary::marker {
        content: " ";
      }
    }
    
    details:open {
      .nav__subnav-toggle::before {
        transform: rotate(0deg);
      }
      
      /* TODO - animation sometimes does not animate on details open */
      .nav__subnav-wrapper {
        > .nav__list {
          transform: translateY(0%);
          opacity: 1;
          z-index: 3;
        }
      }
    }
  }
  
  /*** Variant - Horizontal ***/
  &--horizontal {
    > .nav__list {
      flex-direction: row;
      align-items: stretch;
      padding-inline: 1rem;
    }
    
    .nav__item--level-0 {
      font-size: var(--skeleton-size-text-nav-level-0);
      
      &::before {
        box-shadow: var(--skeleton-color-border-nav-item) -0.5px 0px 0px;
        height: 100%;
        width: 5px;
        left: 0;
      }
      
    }
    
    &--active-trail {
      font-weight: 600;
      border-inline-start: 0px;
      border-block-start: 6px solid var(--skeleton-color-accent-nav-item);
    }
    
    /* end horizontal variant */
  }
  
  /*** Variant - Transparent Background ***/
  &--transparent {
    .nav__list {
      background-color: transparent;
    }
    
    .nav__item--level-0::before {
      display: none;
    }
    
    .nav__item--active-trail {
      border: none;
    }
  }
  
  /*** Variant - Size Small ***/
  &--small {
    
    &.nav--horizontal > .nav__list {
      padding-inline: 0.5rem;
    }
    
    .nav__item,
    .nav__item--level-0 {
      font-size: calc(var(--skeleton-size-text-nav-level-0) * 0.75);
    }
    
    .nav__item--level-1 {
      font-size: calc(var(--skeleton-size-text-nav-level-1) * 0.75);
    }
    
    .nav__item--level-2 {
      font-size: calc(var(--skeleton-size-text-nav-level-2) * 0.75);
    }
  }
  
  /*** Variant - Main Nav ***/
  /* we name the region so the mobile drawer does not effect sidebar nav */
  header &--main {
    background-color: var(--skeleton-color-bg-nav-main);
    padding-inline: 1.5rem;
    
    > .nav__list {
      flex-direction: row;
      flex-flow: row wrap;
      background-color: transparent;
      
      > .nav__item {
        border-block-end: 0;
        box-shadow: none;
      }
      
      > .nav__item--active-trail {
        font-weight: 600;
        border-inline-start: 0px;
      }
    }
    
    .nav__item--level-0::before {
      display: none;
    }
    
    /* mobile menu drawer */
    > .nav__list .nav__subnav-wrapper {
      /* match border radius to focus indicator */
      --skeleton-border-radius-main-nav-subnav: calc(var(--skeleton-size-radius-navlink) + var(--skeleton-size-gap-focus-indicator) + var(--skeleton-size-border-navlink));
      
      position: absolute;
      border-end-start-radius: var(--skeleton-border-radius-main-nav-subnav);
      border-end-end-radius: var(--skeleton-border-radius-main-nav-subnav);
      min-inline-size: 300px;
      overflow: hidden;
      clip-path: polygon(-10% 0, 110% 0, 110% 110%, -10% 110%);
      margin-block-start: 2px;
      
      > .nav__list {
        background-color: var(--skeleton-color-bg-subnav-main);
        margin-inline-start: 0;
        border-end-start-radius: var(--skeleton-size-radius-subnav);
        border-end-end-radius: 8px;
        border: var(--skeleton-size-border-subnav-main) solid var(--skeleton-color-border-bottom-subnav-main);
        border-block-start: 0;
      }
      
      .nav__item:last-of-type,
      .nav__link:last-of-type {
        border-end-end-radius: inherit;
        border-end-start-radius: inherit;
      }
    }
    
    @media (width <=994px) {
      & {
        left: 0;
        right: 0;
        block-size: 100vh;
        display: flex;
        flex-flow: column;
        align-items: flex-start;
        padding-inline: 0;
        position: absolute;
        transition: all 0.5s cubic-bezier(0.77, 0, 0.175, 1);
        z-index: 99;
        transform: translateX(100%);
        background: var(--skeleton-color-bg-nav-mobile);
        border-block-end: 6px solid var(--skeleton-color-border-nav-mobile);
      }
      
      &.is-open {
        transform: translateX(0%);
      }
      
      > .nav__list {
        flex-direction: column;
        z-index: 99;
        background: inherit;
      }
      
      > .nav__list .nav__subnav-wrapper {
        position: relative;
        border-radius: 0;
        
        > .nav__list {
          box-shadow: none;
          border: 0;
          border-radius: 0;
          background: transparent;
        }
        
        > .nav__item {
          padding-inline: 1rem;
        }
        
        > .nav__item--level-0::before {
          display: inline-block;
        }
      }
    }
    
    /* end main nav variant */
  }
  
  /* main secondary sidebar */
  .region--sidebar &--main {
    padding: 1rem 0 0 1.5rem;
  }
  
  /* end main nav */
}