{%
  set title_classes = [
    label_display == 'visually_hidden' ? 'visually-hidden',
    'field__label'
  ]
%}

{%
  set classes = [
    'tags-group'
  ]
%}

{% if label_hidden %}
  {% if multiple %}
    <div{{ attributes.addClass(classes) }}>
      {% for item in items %}
        {# <div{{ attributes.addClass(body_classes) }}>
          <span{{ item.attributes }}>{{ item.content }}</span>
        </div> #}

        {{ include ('skeleton:tag', {
          label: item.content,
          url: item['#url'].toString(),
        }, with_context: false) }}
      {% endfor %}
    </div>
  {% else %}
    {% for item in items %}
      {# <div{{ attributes.addClass(body_classes) }}>
        <span{{ item.attributes }}>{{ item.content }}</span>
      </div> #}
      {{ include ('skeleton:tag', {
        label: item.content,
        url: item['#url'].toString(),
      }, with_context: false) }}
    {% endfor %}
  {% endif %}
{% else %}
  <div{{ attributes.addClass(classes) }}>
    <div{{ title_attributes.addClass(title_classes) }}>{{ label }}</div>
    {% if multiple %}
      <div>
    {% endif %}
    {% for item in items %}
      {# <div{{ attributes.addClass(body_classes) }}>
        <span{{ item.attributes }}>{{ item.content }}</span>
      </div> #}
      {{ include ('skeleton:tag', {
        label: item.content,
        url: item['#url'].toString(),
      }, with_context: false) }}
    {% endfor %}
    {% if multiple %}
      </div>
    {% endif %}
  </div>
{% endif %}
