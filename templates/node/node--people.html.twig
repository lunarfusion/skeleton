{%
  set classes = [
    'article',
    'node'
  ]
%}

{% set attributes = attributes.addClass(classes|filter(v => v != '')) %}

<article{{ attributes }}>

  {{ title_prefix }}
  {% if label and view_mode != "full" %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <footer>
      {{ author_picture }}
      <div{{ author_attributes }}>
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
      </div>
    </footer>
  {% endif %}


  <div{{ content_attributes }}>
    <div class="container">


        <div class="row">
          <div class="col col--12">
            <div class="node__title">
              {{ include ('skeleton:title', {
                content: label,
                html_tag: 'h1',
                size: 'XL',
                variant: 'page',
              }, with_context: false) }}
              </div>
            {# end node title #}
            {{ content.field_specialty }}
          </div>
        </div>

        <div class="row row--wrap-xs">
          <div class="col col--4">
            {{ content.field_image }}
          </div>

          <div class="col col--8">
            <div class="node__body">
              {{ content.body }}
            </div>
          </div>
        </div>


    </div>
  </div>

</article>
